# Public providers require no API keys. Copy to .env for local overrides.
MUSE_DATABASE_PATH=data/muse.db
MUSE_POLL_SECONDS=120
# Bounded HTTP concurrency; tune explicitly after observing rate limits.
MUSE_REQUEST_CONCURRENCY=4
MUSE_MAX_ALTCOINS=100
MUSE_DETAIL_BATCH_SIZE=100
MUSE_UNIVERSE_REFRESH_SECONDS=86400
MUSE_MAX_MEMES=8
MUSE_MEME_CHAINS=["ethereum","base","bsc","solana"]
# Phase 4 optional discovery; identified by chain + address, never ticker alone:
MUSE_MEME_WATCHLIST=[]
MUSE_ENABLE_COLLECTOR=true
MUSE_ENABLE_GOPLUS=false
# Official public read-only market-data endpoint (default):
MUSE_BINANCE_SPOT_URL=https://data-api.binance.vision
MUSE_STALE_SECONDS=300
MUSE_ALERT_COOLDOWN_SECONDS=3600
# Optional protection for API requests when exposing the service beyond loopback:
# MUSE_API_TOKEN=
# Optional: route only Binance hosts through a separate proxy (e.g. a Singapore
# node) when the default egress IP is geo-blocked (HTTP 451). Plain http/https
# proxy URL, e.g. http://user:pass@sg-host:3128 . Other hosts keep default egress.
# MUSE_BINANCE_PROXY=
# V4 derivatives use OKX public APIs. Legacy binance/auto remain readable,
# but do not enable Binance Futures requests or fallback.
MUSE_FUTURES_SOURCE=okx
MUSE_OKX_URL=https://www.okx.com

# V4: BTC and ETH are core assets, outside these 100 slots.
MUSE_PINNED_SYMBOLS=[]
MUSE_UNIVERSE_MAX_REPLACEMENTS=10
MUSE_MIN_QUOTE_VOLUME_USDT=100000
MUSE_TIME_ALIGNMENT_SECONDS=120
MUSE_STATISTICS_STALE_SECONDS=600
# Legacy option remains readable; score-only changes no longer send notifications.
MUSE_ALERT_SCORE_DELTA=10
# Fresh market risk / candidate cancellation must be delivered within this window.
MUSE_RISK_NOTIFICATION_MAX_AGE_SECONDS=300
# Delivery guards for pre-pump alerts; observation policy, not calibrated alpha.
MUSE_PRE_PUMP_CONFIRMATION_SECONDS=300
MUSE_PRE_PUMP_MAX_CHASE_PCT=3
# Entry checks: fresh current inputs plus valid archived anchors; not calibrated alpha.
MUSE_ENABLE_ENTRY_QUALITY=true
# Both book and candle source times must differ by at least 60 seconds.
MUSE_ENTRY_CONFIRMATION_SECONDS=60
# Historical lookback and component-time separation maximum; current age stays 300s.
MUSE_ENTRY_ANCHOR_MAX_AGE_SECONDS=1800
MUSE_ENTRY_MIN_DEPTH_USDT=10000
MUSE_ENTRY_MAX_CHASE_PCT=3
# Public basket proxy starts as research context, with no effect on entry eligibility.
MUSE_MARKET_CONFIRMATION_MODE=observe
MUSE_MARKET_CONFIRMATION_MIN_ASSETS=5
MUSE_MARKET_CONFIRMATION_MIN_COVERAGE=0.7
MUSE_VALIDATION_MIN_SAMPLES=30
# Independent price-label queue; does not start market/research collection.
MUSE_ENABLE_BACKGROUND_VALIDATION=true
MUSE_VALIDATION_BATCH_SIZE=16
# Cooperative budget between tasks; an in-flight SQLite query can take longer.
MUSE_VALIDATION_BUDGET_SECONDS=2
MUSE_VALIDATION_TICK_SECONDS=10
# 100 keeps current API request weight; measure coverage before increasing to 500/1000.
MUSE_SPOT_DEPTH_LIMIT=100
# Legacy futures_source values stay readable; V4 uses OKX exclusively.

# Phase 2–6 framework. Research checks are manual; no daily task is created.
MUSE_ENABLE_INTELLIGENCE=true
MUSE_ENABLE_CONTEXT_OBSERVATIONS=true
# BTC context hypotheses: WATCH only; thresholds are uncalibrated.
MUSE_CONTEXT_MVRV_PERCENTILE=90
MUSE_CONTEXT_OPTIONS_IV_PCT=80
MUSE_ENABLE_MEME_DISCOVERY=false
MUSE_ENABLE_SOCIAL=false
MUSE_MEME_DISCOVERY_BATCH_SIZE=20
MUSE_RESEARCH_MAX_DOCUMENTS=100
MUSE_RESEARCH_MAX_BYTES=2000000
MUSE_THRESHOLD_VERSION=thresholds-v4-2
MUSE_BREAKOUT_THRESHOLD_PCT=3
MUSE_RANKING_HIT_THRESHOLD_PCT=2
MUSE_ML_MIN_SAMPLES=200
# Optional X credentials (manual collection or explicitly configured worker scope).
# MUSE_X_BEARER_TOKEN=
# MUSE_X_QUERY=(BTC OR ETH OR crypto) -is:retweet lang:en
# Keep the existing Muse email connection; use import-email and research-queue.
# RPC live pool listeners and complete holder coverage await cloud adapters.

# Free BTC data: explicit requests, or the opt-in cloud worker below.
# Coin Metrics daily MVRV, market cap, supply; BGeometrics delayed SOPR and cost basis.
MUSE_COINMETRICS_URL=https://community-api.coinmetrics.io/v4
MUSE_BGEOMETRICS_URL=https://bitcoin-data.com/v1
MUSE_DERIBIT_URL=https://www.deribit.com/api/v2
MUSE_BTC_HISTORY_DAYS=365
MUSE_BTC_ONCHAIN_REFRESH_SECONDS=86400
MUSE_BTC_OPTIONS_REFRESH_SECONDS=300
MUSE_DERIBIT_GREEKS_LIMIT=12

# Muse cloud may opt in to this application worker. No Codex scheduled task is created.
MUSE_ENABLE_BACKGROUND_INTELLIGENCE=false
MUSE_BACKGROUND_SCOPES=["macro","events","onchain","options"]
MUSE_WORKER_TICK_SECONDS=30
MUSE_EVENT_REFRESH_SECONDS=300
MUSE_EVENT_REACTION_TOLERANCE_SECONDS=30
MUSE_SOCIAL_MAX_PAGES=3
